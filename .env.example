# Service Authentication
# Configure all three values together when exposing the authenticated HTTP endpoint.
SEMMEM_ISSUER=<CHANGE-ME>
SEMMEM_AUDIENCE=<CHANGE-ME>
SEMMEM_PUBLIC_URL=<CHANGE-ME>

# Optional Overrides
# Set only when overriding the local socket or index resource defaults.
# SEMMEM_SOCKET=<CHANGE-ME>
# SEMMEM_INDEX_MEMORY_BYTES=<CHANGE-ME>
# SEMMEM_INDEX_THREADS=<CHANGE-ME>
